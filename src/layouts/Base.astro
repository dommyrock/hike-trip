---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Val Gardena Trails — Ortisei',
  description = 'A clean, fast finder for the best hiking trails around Ortisei in Val Gardena, Dolomites — mapped by difficulty, with distance, peak height and route detail.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- PWA: installable app + offline shell (see public/sw.js) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#eaeef3" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Display: Bricolage Grotesque · Body: Hanken Grotesk -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline>
      if ('serviceWorker' in navigator)
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
    </script>
  </body>
</html>
