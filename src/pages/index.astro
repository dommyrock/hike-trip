---
import Base from '../layouts/Base.astro';
import TrailCard from '../components/TrailCard.astro';
import { trails, origins } from '../data/trails.js';
import { haversineKm } from '../lib/geo.js';

// First paint / no-JS: the default origin's trails, distances from its base
// town, nearest trailhead first. Other origins load client-side via the switcher.
const home = origins[0];
const initial = trails
  .filter((t) => t.origin === home.slug)
  .map((t) => ({ ...t, distKm: haversineKm(home.coords, t.start) }))
  .sort((a, b) => a.distKm - b.distKm);

const total = initial.length;
---

<Base>
  <div class="wrap">
    <header class="top">
      <div class="brand">
        <div class="mk">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 20h18L14.5 7l-3 5.2L9 8.4 3 20Z" /><path d="M11.5 12.2 14.5 7" /></svg>
        </div>
        <div>
          <h1 id="title">{home.title}</h1>
          <p id="subtitle">Hiking finder · base: {home.name}</p>
        </div>
      </div>
      <div class="meta">
        <span><b id="m-count">{total}</b> trails</span>
        <span id="m-region">{home.region}</span>
      </div>
    </header>

    <div class="mapwrap">
      <div id="map"></div>
      <div class="map-ctrl layers">
        <button id="lyr-light" class="on">Standard</button>
        <button id="lyr-terrain">Terrain</button>
      </div>
      <div class="legend">
        <span class="easy"><i></i>Easy</span>
        <span class="medium"><i></i>Medium</span>
        <span class="hard"><i></i>Hard</span>
        <span class="mustv"><i></i>Must visit</span>
      </div>
      <button class="recenter" id="recenter" title="Frame all trails">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3v3M12 18v3M3 12h3M18 12h3" /><circle cx="12" cy="12" r="4.5" /></svg>
      </button>
    </div>

    <div class="controls">
      <div class="field region" title="Trail region — switches the whole dataset">
        <select id="origin">
          {origins.map((o) => <option value={o.slug}>{o.region}</option>)}
        </select>
      </div>
      <div class="field search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.2-3.2" /></svg>
        <input id="q" type="text" placeholder="Search trails, peaks, areas…" autocomplete="off" />
      </div>
      <div class="field from">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        <input id="from" type="text" list="bases" value={home.name} autocomplete="off" title="Distances are measured from here" />
        <datalist id="bases"></datalist>
      </div>
      <div class="field within">
        <span class="lbl">Within</span>
        <input id="dist" type="range" min="2" max="25" step="1" value="25" title="Max distance from base" />
        <span class="val" id="distVal">Any</span>
      </div>
      <div class="field diff-seg" role="group" aria-label="Filter by difficulty">
        <span class="lbl">Difficulty</span>
        <button type="button" class="tgl tgl--easy" data-d="easy" title="Easy" aria-pressed="false"></button>
        <button type="button" class="tgl tgl--medium" data-d="medium" title="Medium" aria-pressed="false"></button>
        <button type="button" class="tgl tgl--hard" data-d="hard" title="Hard" aria-pressed="false"></button>
      </div>
      <div class="sort">
        <label for="sort">Sort</label>
        <select id="sort">
          <option value="dist">Nearest</option>
          <option value="diff">Easiest first</option>
          <option value="peak">Highest peak</option>
        </select>
      </div>
    </div>

    <div class="count" id="count">
      <b>{initial.length}</b> of {total} trails · distances from <b>{home.name}</b> (straight-line to trailhead)
    </div>

    <div class="grid" id="grid">
      {initial.map((t, i) => <TrailCard trail={t} distKm={t.distKm} index={i} />)}
    </div>
  </div>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { trails as staticTrails, origins } from '../data/trails.js';
  import {
    haversineKm,
    DIFF_RANK,
    DIFF_LABEL,
    fmtDurationShort as fmtDur,
  } from '../lib/geo.js';

  // medium uses the matte pure yellow on the map (--medium-map in global.css);
  // badges/cards elsewhere keep the amber --medium
  const COLORS = { easy: '#34a06a', medium: '#d8ac1c', hard: '#d24e48' };
  const MTN =
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 20h18L14.5 7l-3 5.2L9 8.4 3 20Z"/></svg>';

  // ============================ MAP ============================
  const map = L.map('map', { zoomControl: true, attributionControl: true });
  map.zoomControl.setPosition('topleft');

  // Standard OpenStreetMap basemap — the default OSM look, untouched.
  const light = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution:
      '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  });
  const terrain = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
    subdomains: 'abc',
    maxZoom: 17,
    attribution:
      '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>, <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)',
  });
  light.addTo(map);

  // Pin marking the current base — the "From" location distances are measured
  // from. Inline-SVG divIcon (same approach as the trail markers — no image
  // assets, so nothing the bundler can break). Same glyph as the "From" field.
  const PIN =
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6" fill="#fff"/></svg>';
  const pinIcon = L.divIcon({
    className: '',
    html: `<div class="base-pin">${PIN}</div>`,
    iconSize: [34, 34],
    iconAnchor: [17, 30], // teardrop tip
    tooltipAnchor: [0, -30],
  });
  const basePin = L.marker(origins[0].coords, { icon: pinIcon })
    .addTo(map)
    .bindTooltip(origins[0].name, { direction: 'top' });

  // Trail data + map layers are rebuilt whenever the origin (region) changes —
  // see loadOrigin() at the bottom, which owns fetching D1 data via the Worker
  // with the bundled dataset as fallback.
  let trails = [];
  let layers = {}; // id -> {marker, line, casing, group, trail}
  let all = L.featureGroup();

  function clearLayers() {
    map.closePopup();
    Object.values(layers).forEach((L0) => map.removeLayer(L0.group));
    layers = {};
    all = L.featureGroup();
  }

  // one layer-group + marker per trail
  function buildLayers() {
    clearLayers();
    trails.forEach((t) => {
      const col = COLORS[t.difficulty];
      const casing = L.polyline(t.path, { color: '#ffffff', weight: 8, opacity: 0.7, lineCap: 'round', lineJoin: 'round' });
      const line = L.polyline(t.path, { color: col, weight: 4, opacity: 0.9, lineCap: 'round', lineJoin: 'round' });
      const icon = L.divIcon({
        className: '',
        html: `<div class="mk-pin mk-pin--${t.difficulty}${t.mustVisit ? ' mk-pin--must' : ''}">${MTN}</div>`,
        iconSize: [40, 40],
        iconAnchor: [20, 20],
      });
      const marker = L.marker(t.peak, { icon, riseOnHover: true });

      // hover tooltip card (content filled by setTip on each render)
      marker.bindTooltip('', {
        className: 'trail-tip',
        direction: 'top',
        offset: [0, -16],
        opacity: 1,
      });

      const group = L.layerGroup([casing, line, marker]);
      group.addTo(map);
      all.addLayer(casing);
      all.addLayer(line);
      all.addLayer(marker);

      marker.on('mouseover', () => emphasize(t.id, true));
      marker.on('mouseout', () => emphasize(t.id, false));
      line.on('mouseover', () => {
        emphasize(t.id, true);
        marker.openTooltip();
      });
      line.on('mouseout', () => {
        emphasize(t.id, false);
        marker.closeTooltip();
      });
      // click = open the detail popup in place (no page scroll);
      // press-and-hold / long-press = jump straight down to the card
      // offsets compensate Leaflet's built-in 20px popup margin (tip hidden):
      // -2 → just above the 40px pin; 10 → ~10px above the clicked line point
      marker.on('click', () => {
        if (consumeHold()) return;
        marker.closeTooltip();
        openTrailPopup(t, marker.getLatLng(), -2);
      });
      line.on('click', (e) => {
        if (consumeHold()) return;
        marker.closeTooltip();
        openTrailPopup(t, e.latlng, 10);
      });
      wireHold(marker, t);
      wireHold(line, t);

      layers[t.id] = { marker, line, casing, group, trail: t };
    });
    if (all.getLayers().length) {
      all.addLayer(basePin); // frame the base pin together with the trails
      map.fitBounds(all.getBounds().pad(0.12));
    } else {
      map.setView(state.origin.coords, 11);
    }
  }

  const badgeHTML = (d) => `<span class="badge badge--${d}">${DIFF_LABEL[d]}</span>`;
  const tipStat = (k, v, unit) =>
    `<div class="tip-stat"><div class="k">${k}</div><div class="v">${v}${
      unit ? ` <small>${unit}</small>` : ''
    }</div></div>`;

  // One detail widget for both the hover tooltip and the click popup: all six
  // card stats in a smaller-font 3-col grid, distance line under the name.
  // withGo adds the wide scroll-to-card button (popup only — tooltips can't
  // take pointer events).
  function detailHTML(t, withGo = false) {
    const d = haversineKm(state.base.coords, t.start);
    return (
      `<div class="tip-in">` +
      `<div class="tip-head"><span class="tip-name">${t.name}</span>${badgeHTML(t.difficulty)}</div>` +
      `<div class="tip-dist">${d.toFixed(1)} km from ${state.base.name}</div>` +
      `<div class="tip-stats">` +
      tipStat('Peak', t.peakM.toLocaleString(), 'm') +
      tipStat('Length', t.lengthKm, 'km') +
      tipStat('Ascent', '+' + t.ascentM, 'm') +
      tipStat('Time', fmtDur(t.durationH)) +
      tipStat('Type', t.type ?? '—') +
      tipStat('Season', t.season ?? '—') +
      `</div>` +
      (withGo
        ? `<button class="pop-go" type="button" data-id="${t.id}" title="More details" aria-label="Scroll to trail details">` +
          `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v13M6 12l6 6 6-6"/></svg>` +
          `</button>`
        : '') +
      `</div>`
    );
  }

  function setTip(t) {
    layers[t.id].marker.setTooltipContent(detailHTML(t));
  }

  function emphasize(id, on) {
    const L0 = layers[id];
    if (!L0) return;
    L0.line.setStyle({ weight: on ? 6 : 4, opacity: on ? 1 : 0.9 });
    L0.casing.setStyle({ weight: on ? 11 : 8, opacity: on ? 0.9 : 0.7 });
    if (on) L0.line.bringToFront();
    const el = L0.marker.getElement && L0.marker.getElement();
    if (el) {
      const mk = el.querySelector('.mk-pin');
      if (mk) mk.classList.toggle('is-active', on);
    }
    const card = document.querySelector(`.card[data-id="${id}"]`);
    if (card) card.classList.toggle('is-active', on);
  }

  // map item hold / popup arrow -> scroll down to the card and flash it in
  // waymark yellow (same palette as the trail-number tag) so the target is
  // unmistakable after the scroll settles
  let targetTimer;
  function scrollToCard(id) {
    const card = document.querySelector(`.card[data-id="${id}"]`);
    if (!card) return;
    const y = card.getBoundingClientRect().top + window.pageYOffset - 90;
    window.scrollTo({ top: y, behavior: 'smooth' });
    document.querySelectorAll('.card.is-target').forEach((c) => c.classList.remove('is-active', 'is-target'));
    card.classList.add('is-active', 'is-target');
    clearTimeout(targetTimer);
    targetTimer = setTimeout(() => card.classList.remove('is-active', 'is-target'), 1800);
  }

  // card click -> fly the map to the trail. Deliberately NO page scroll — the
  // footer MAP button is the explicit "take me to the map" affordance.
  function flyToTrail(id) {
    const L0 = layers[id];
    if (!L0) return;
    map.flyToBounds(L0.line.getBounds(), { padding: [80, 80], maxZoom: 14, duration: 0.7 });
  }

  function scrollToMap() {
    document.querySelector('.mapwrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ==================== MAP POPUP + HOLD-TO-SCROLL ====================
  // Shared popup for marker/line clicks: the expanded detail card with a wide
  // "More details" button at the bottom that scrolls to the trail card.
  // Dismiss = tap anywhere on the map (no close button crowding the badge).
  let popupTrailId = null;
  const trailPopup = L.popup({
    className: 'trail-pop',
    closeButton: false,
    minWidth: 252,
    maxWidth: 252,
    autoPanPadding: [46, 46],
  });

  function openTrailPopup(t, latlng, offY) {
    trailPopup.options.offset = [0, offY];
    popupTrailId = t.id;
    trailPopup.setLatLng(latlng).setContent(detailHTML(t, true)).openOn(map);
  }
  map.on('popupclose', () => (popupTrailId = null));
  map.on('popupopen', (e) => {
    const btn = e.popup.getElement()?.querySelector('.pop-go');
    if (btn)
      btn.addEventListener('click', () => {
        map.closePopup();
        scrollToCard(btn.dataset.id);
      });
  });

  // press-and-hold (~0.5 s) on a marker/line scrolls straight to the card.
  // contextmenu doubles as native long-press on touch (Leaflet's tapHold
  // synthesizes it on iOS Safari). suppressClick swallows the click that the
  // browser fires on release after a hold, so the popup doesn't also open.
  let holdTimer;
  let suppressClick = false;
  let suppressReset;
  const cancelHold = () => clearTimeout(holdTimer);
  map.on('movestart zoomstart dragstart', cancelHold);
  function holdScroll(t) {
    suppressClick = true;
    clearTimeout(suppressReset);
    suppressReset = setTimeout(() => (suppressClick = false), 1200);
    map.closePopup();
    scrollToCard(t.id);
  }
  function consumeHold() {
    const held = suppressClick;
    suppressClick = false;
    return held;
  }
  function wireHold(layer, t) {
    layer.on('mousedown', () => {
      cancelHold();
      holdTimer = setTimeout(() => holdScroll(t), 500);
    });
    layer.on('mouseup mouseout', cancelHold);
    layer.on('contextmenu', (e) => {
      L.DomEvent.preventDefault(e.originalEvent || e);
      cancelHold();
      holdScroll(t);
    });
  }

  // ============================ STATE + RENDER ============================
  const state = {
    q: '',
    diffs: new Set(),
    origin: origins[0],
    base: { name: origins[0].name, coords: origins[0].coords },
    maxDist: 25, // 25 == "Any"
    sort: 'dist',
  };

  // every base change goes through here so the pin tracks the "From" location
  function setBase(name, coords) {
    state.base = { name, coords };
    basePin.setLatLng(coords).setTooltipContent(name);
  }

  function visibleTrails() {
    let list = trails.map((t) => ({ ...t, distKm: haversineKm(state.base.coords, t.start) }));
    const q = state.q.trim().toLowerCase();
    if (q)
      list = list.filter((t) =>
        (t.name + ' ' + t.area + ' ' + t.massif + ' ' + t.peakName + ' ' + t.blurb).toLowerCase().includes(q)
      );
    if (state.diffs.size) list = list.filter((t) => state.diffs.has(t.difficulty));
    if (state.maxDist < 25) list = list.filter((t) => t.distKm <= state.maxDist);
    if (state.sort === 'dist') list.sort((a, b) => a.distKm - b.distKm);
    else if (state.sort === 'diff')
      list.sort((a, b) => DIFF_RANK[a.difficulty] - DIFF_RANK[b.difficulty] || a.distKm - b.distKm);
    else if (state.sort === 'peak') list.sort((a, b) => b.peakM - a.peakM);
    return list;
  }

  function statBlock(k, v, unit) {
    return `<div class="stat"><div class="k">${k}</div><div class="v">${v}${
      unit ? `<small>${unit}</small>` : ''
    }</div></div>`;
  }

  function cardHTML(t, i) {
    return `<article class="card" data-id="${t.id}" data-d="${t.difficulty}" style="animation-delay:${Math.min(
      i * 45,
      320
    )}ms">
    <div class="head">
      <div class="ico">${MTN}</div>
      <div><h3>${t.name}</h3><div class="area">${t.area}</div></div>
      ${
        t.mustVisit
          ? `<span class="must" title="Must visit"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg></span>`
          : ''
      }
      <span class="badge badge--${t.difficulty}">${DIFF_LABEL[t.difficulty]}</span>
    </div>
    <p class="blurb">${t.blurb}</p>
    <div class="stats">
      ${statBlock('Peak', t.peakM.toLocaleString(), 'm')}
      ${statBlock('Length', t.lengthKm, 'km')}
      ${statBlock('Ascent', '+' + t.ascentM, 'm')}
      ${statBlock('Time', fmtDur(t.durationH))}
      ${statBlock('Type', t.type ?? '—')}
      ${statBlock('Season', t.season ?? '—')}
    </div>
    <div class="tags">
      <span class="tag tag--trail" title="Trail marker — the route number on signposts along the way"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 17V7l8-3 8 3v10M4 17l8 3 8-3M4 17V7"/></svg>${t.trail}</span>
      <span class="tag"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11h18M6 11V7a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v4M5 11v6m14-6v6M8 17v2m8-2v2"/></svg>${t.access}</span>
    </div>
    <div class="foot">
      <span class="dist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-6.3-7-11a7 7 0 0 1 14 0c0 4.7-7 11-7 11z"/><circle cx="12" cy="10" r="2.4"/></svg>${t.distKm.toFixed(1)} km from ${state.base.name.split(' ')[0]}</span>
      <button class="seemap" type="button" title="Show on the map" aria-label="Show on the map"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V6M6 12l6-6 6 6"/></svg>MAP</button>
    </div>
  </article>`;
  }

  const grid = document.getElementById('grid');
  const countEl = document.getElementById('count');
  function render() {
    const list = visibleTrails();
    trails.forEach((t) => {
      const shown = list.some((x) => x.id === t.id);
      const L0 = layers[t.id];
      if (shown && !map.hasLayer(L0.group)) L0.group.addTo(map);
      if (!shown && map.hasLayer(L0.group)) map.removeLayer(L0.group);
      if (shown) setTip(t);
    });
    if (popupTrailId && !list.some((x) => x.id === popupTrailId)) map.closePopup();
    grid.innerHTML = list.length
      ? list.map(cardHTML).join('')
      : `<div class="empty">No trails match. Try clearing a filter.</div>`;
    countEl.innerHTML = `<b>${list.length}</b> of ${trails.length} trails · distances from <b>${state.base.name}</b> (straight-line to trailhead)`;
    document.getElementById('m-count').textContent = list.length;
    wireCards();
  }

  function wireCards() {
    grid.querySelectorAll('.card').forEach((card) => {
      const id = card.dataset.id;
      card.addEventListener('mouseenter', () => {
        emphasize(id, true);
        layers[id]?.marker.openTooltip();
      });
      card.addEventListener('mouseleave', () => {
        emphasize(id, false);
        layers[id]?.marker.closeTooltip();
      });
      card.addEventListener('click', () => flyToTrail(id));
      // the MAP button is the only thing that scrolls the page up
      card.querySelector('.seemap')?.addEventListener('click', (e) => {
        e.stopPropagation();
        flyToTrail(id);
        scrollToMap();
      });
    });
  }

  // ============================ CONTROLS ============================
  const bl = document.getElementById('bases');
  function fillBases() {
    bl.innerHTML = '';
    // origins first (typing one switches the whole region), then local base towns
    const names = new Set([...origins.map((o) => o.name), ...Object.keys(state.origin.bases)]);
    names.forEach((n) => {
      const o = document.createElement('option');
      o.value = n;
      bl.appendChild(o);
    });
  }

  document.getElementById('q').addEventListener('input', (e) => {
    state.q = e.target.value;
    render();
  });
  document.getElementById('sort').addEventListener('change', (e) => {
    state.sort = e.target.value;
    render();
  });
  const distRange = document.getElementById('dist');
  const distVal = document.getElementById('distVal');
  distRange.addEventListener('input', () => {
    state.maxDist = +distRange.value;
    distVal.textContent = state.maxDist >= 25 ? 'Any' : `${state.maxDist} km`;
    render();
  });
  // difficulty filter — three colour toggles; none active == show all
  document.querySelectorAll('.tgl').forEach((b) => {
    b.addEventListener('click', () => {
      const d = b.dataset.d;
      const on = !state.diffs.has(d);
      if (on) state.diffs.add(d);
      else state.diffs.delete(d);
      b.classList.toggle('on', on);
      b.setAttribute('aria-pressed', String(on));
      render();
    });
  });

  const fromInput = document.getElementById('from');
  async function resolveBase() {
    const name = fromInput.value.trim();
    if (!name) return;
    // an origin name switches the whole region (same as the region select)
    const o = origins.find((x) => x.name.toLowerCase() === name.toLowerCase());
    if (o) {
      if (o.slug !== state.origin.slug) {
        originSel.value = o.slug;
        loadOrigin(o.slug);
      } else {
        setBase(o.name, o.coords);
        render();
      }
      return;
    }
    if (state.origin.bases[name]) {
      setBase(name, state.origin.bases[name]);
      render();
      return;
    }
    // try Nominatim (OpenStreetMap) for anything else; biased to the region
    try {
      fromInput.style.opacity = 0.6;
      const url =
        'https://nominatim.openstreetmap.org/search?format=json&limit=1&q=' +
        encodeURIComponent(name + ', ' + state.origin.searchBias);
      const r = await fetch(url, { headers: { Accept: 'application/json' } });
      const j = await r.json();
      if (j && j[0]) {
        setBase(name, [parseFloat(j[0].lat), parseFloat(j[0].lon)]);
        render();
      }
    } catch (err) {
      /* offline / rate-limited: keep previous base */
    } finally {
      fromInput.style.opacity = 1;
    }
  }
  fromInput.addEventListener('change', resolveBase);
  fromInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      resolveBase();
    }
  });

  // basemap toggle
  const bLight = document.getElementById('lyr-light');
  const bTerrain = document.getElementById('lyr-terrain');
  bLight.addEventListener('click', () => {
    if (map.hasLayer(terrain)) map.removeLayer(terrain);
    light.addTo(map);
    bLight.classList.add('on');
    bTerrain.classList.remove('on');
  });
  bTerrain.addEventListener('click', () => {
    if (map.hasLayer(light)) map.removeLayer(light);
    terrain.addTo(map);
    bTerrain.classList.add('on');
    bLight.classList.remove('on');
  });

  document
    .getElementById('recenter')
    .addEventListener('click', () => map.flyToBounds(all.getBounds().pad(0.12), { duration: 0.6 }));

  // ============================ ORIGIN (region) ============================
  const originSel = document.getElementById('origin');
  originSel.addEventListener('change', () => loadOrigin(originSel.value));

  // Switch the whole dataset to another origin: bundled data first (instant,
  // offline-safe), then live D1 via the Worker. Filters survive the switch;
  // the base resets to the origin's home town.
  async function loadOrigin(slug) {
    const o = origins.find((x) => x.slug === slug) || origins[0];
    state.origin = o;
    setBase(o.name, o.coords);
    fromInput.value = o.name;
    fillBases();
    document.getElementById('title').textContent = o.title;
    document.getElementById('subtitle').textContent = `Hiking finder · base: ${o.name}`;
    document.getElementById('m-region').textContent = o.region;
    document.title = `${o.title} — ${o.name}`;

    trails = staticTrails.filter((t) => t.origin === o.slug);
    buildLayers();
    render();

    try {
      const r = await fetch(`/api/trails?origin=${o.slug}`);
      if (r.ok) {
        const j = await r.json();
        if (Array.isArray(j.trails) && j.trails.length && state.origin === o) {
          trails = j.trails;
          buildLayers();
          render();
        }
      }
    } catch {
      /* offline or no API — keep the build-time snapshot */
    }
  }

  loadOrigin(origins[0].slug);
</script>
