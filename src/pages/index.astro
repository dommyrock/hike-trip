---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FilterBar from '../components/FilterBar.astro';
import BottomSheet from '../components/BottomSheet.astro';
import TrailCard from '../components/TrailCard.astro';
import { trails, origins } from '../data/trails.js';
import { haversineKm } from '../lib/geo.js';

// First paint / no-JS: every region, nearest to the default base first — the
// first page of cards only; the client pages the rest in (PAGE in the script).
const PAGE = 24;
const home = origins[0];
const initial = trails
  .map((t) => ({ ...t, distKm: haversineKm(home.coords, t.start) }))
  .sort((a, b) => a.distKm - b.distKm)
  .slice(0, PAGE);

const total = trails.length;
const counts = Object.fromEntries(origins.map((o) => [o.slug, trails.filter((t) => t.origin === o.slug).length]));
---

<Base
  title="Alpine Trails — hiking finder"
  description="A clean, fast hiking-trail finder across the Alps — Dolomites, Julian Alps, Austria, Switzerland and Germany — mapped by difficulty, with photos, distance, high point and route detail."
>
  <div class="wrap">
    <SiteHeader active="finder" subtitle={`Hiking finder · base: ${home.name}`} brandIsHeading>
      <span slot="meta"><b id="m-count">{total}</b> trails · <span id="m-region">All regions</span></span>
    </SiteHeader>

    <div class="mapwrap">
      <div id="map"></div>
      <div class="map-ctrl layers">
        <button id="lyr-light" class="on" type="button">Standard</button>
        <button id="lyr-terrain" type="button">Terrain</button>
      </div>
      <div class="legend" aria-hidden="true">
        <span><i class="dot dot--easy"></i>Easy</span>
        <span><i class="dot dot--medium"></i>Medium</span>
        <span><i class="dot dot--hard"></i>Hard</span>
        <span><i class="dot dot--legend-must"></i>Must visit</span>
      </div>
      <button class="recenter" id="recenter" type="button" title="Frame the trails shown" aria-label="Frame the trails shown">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 3v3M12 18v3M3 12h3M18 12h3"></path><circle cx="12" cy="12" r="4.5"></circle></svg>
      </button>
    </div>

    <FilterBar origins={origins} counts={counts} total={total} home={home} />

    <div class="count" id="count">
      <b>{total}</b> of {total} trails · distances from <b>{home.name}</b> (straight-line to trailhead)
    </div>

    <div class="grid" id="grid" data-page={PAGE}>
      {initial.map((t, i) => <TrailCard trail={t} distKm={t.distKm} baseName={home.name} index={i} />)}
    </div>
    <div class="more-wrap">
      <button class="more-btn" id="more" type="button" hidden={total <= PAGE}>Show {Math.min(PAGE, total - PAGE)} more</button>
    </div>

    <p class="fineprint">
      Map data © OpenStreetMap contributors. Photos from Wikimedia Commons under their stated licences, credited on each card.
    </p>
  </div>

  <BottomSheet id="filter-sheet" title="Filters">
    <div id="fs-slot" class="fs-slot"></div>
    <div slot="foot" class="sheet-foot">
      <button type="button" class="sheet-reset" id="fs-reset">Reset</button>
      <button type="button" class="sheet-cta" data-close>Show <b id="fs-count">{total}</b> trails</button>
    </div>
  </BottomSheet>
  <BottomSheet id="trail-sheet" title="Trail details" quietTitle />
  <!-- "Link copied" after Share falls back to the clipboard (always in the DOM so it's announced) -->
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</Base>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  // extends the global L that leaflet sets — must come after the leaflet import.
  // Only the core (animation) CSS: the cluster icons are styled in global.css.
  import 'leaflet.markercluster';
  import 'leaflet.markercluster/dist/MarkerCluster.css';
  import { trails as staticTrails, origins, decorate } from '../data/trails.js';
  import { haversineKm, DIFF_RANK, inSeason } from '../lib/geo.js';
  import { ICON } from '../lib/icons.js';
  import { cardHTML, tipHTML, popupHTML, saveTitle, BUZZ_RANK, esc, fmtDist } from '../lib/card.js';
  import { PHONE, sheet, relocate } from '../lib/mobile.js';

  const PAGE = +document.getElementById('grid').dataset.page; // cards per "Show more" step (set in the frontmatter)
  // Within slider: the range input is an index into these stops (km, from
  // FilterBar.astro); the index one past the last stop is "Any" (no limit)
  const WITHIN_KM = document.getElementById('dist').dataset.stops.split(',').map(Number);
  const ANY = WITHIN_KM.length;

  // medium uses the matte pure yellow on the map (--medium-map in global.css);
  // badges/cards elsewhere keep the amber --medium
  const COLORS = { easy: '#34a06a', medium: '#d8ac1c', hard: '#d24e48' };
  // emphasized (hovered / popup-open) trail recolours to deep navy so it stands
  // out from the difficulty-coloured lines around it (--selected in global.css)
  const SELECTED = '#13306e';
  const originBySlug = Object.fromEntries(origins.map((o) => [o.slug, o]));

  // ============================ MAP ============================
  const map = L.map('map', { zoomControl: true, attributionControl: true });
  map.zoomControl.setPosition('topleft');

  // Standard OpenStreetMap basemap — the default OSM look, untouched.
  const light = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  });
  const terrain = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
    subdomains: 'abc',
    maxZoom: 17,
    attribution:
      '&copy; <a href="https://openstreetmap.org/copyright">OpenStreetMap</a>, <a href="https://opentopomap.org">OpenTopoMap</a> (CC-BY-SA)',
  });
  light.addTo(map);

  // Pin marking the current base — the "From" location distances are measured
  // from. Inline-SVG divIcon (same approach as the trail markers — no image
  // assets, so nothing the bundler can break). Same glyph as the "From" field.
  const PIN =
    '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6" fill="#fff"/></svg>';
  const pinIcon = L.divIcon({
    className: '',
    html: `<div class="base-pin">${PIN}</div>`,
    iconSize: [34, 34],
    iconAnchor: [17, 30], // teardrop tip
    tooltipAnchor: [0, -30],
  });
  const basePin = L.marker(origins[0].coords, { icon: pinIcon, zIndexOffset: 500 })
    .addTo(map)
    .bindTooltip(origins[0].name, { direction: 'top' });

  // Trail map layers are built once per dataset (bundled, then D1 — see
  // loadData() at the bottom) and only shown/dimmed by render().
  let trails = [];
  let layers = {}; // id -> {marker, line, casing, lines, dots, trail, shown}
  // the trail the user last clicked — stays navy-highlighted until another is
  // clicked, even after its popup closes (lets you compare lines popup-free)
  let selectedTrailId = null;

  // Zoomed out, nearby dots of the trails that pass the filters merge into a
  // count bubble (route lines are never clustered). Filtered-out trails keep
  // their dimmed dot directly on the map, outside the clusters. From
  // CLUSTER_OFF_ZOOM in every dot stands alone, so there's nothing to spiderfy.
  // A marker inside a cluster has no element (getElement() is undefined) and
  // can't open its tooltip — every caller below tolerates that. The bubbles
  // get a pane just above the markers: the base pin (which sits in the biggest
  // cluster at the overview) must not hide a count.
  const CLUSTER_OFF_ZOOM = 10;
  map.createPane('clusters').style.zIndex = 610; // markerPane 600 < this < tooltipPane 650
  const cluster = L.markerClusterGroup({
    disableClusteringAtZoom: CLUSTER_OFF_ZOOM,
    maxClusterRadius: 44,
    showCoverageOnHover: false,
    spiderfyOnMaxZoom: false,
    clusterPane: 'clusters',
    iconCreateFunction: clusterIcon,
  }).addTo(map);

  // glass disc with the count, ringed by the difficulty mix of the trails
  // inside; focusable like any marker (Enter zooms in), named "N trails"
  function clusterIcon(c) {
    const kids = c.getAllChildMarkers();
    const n = kids.length;
    const by = { easy: 0, medium: 0, hard: 0 };
    kids.forEach((m) => by[layers[m.options.trailId]?.trail.difficulty]++);
    const e = (by.easy / n) * 100;
    const m = e + (by.medium / n) * 100;
    const size = n < 10 ? 34 : n < 25 ? 40 : 46;
    return L.divIcon({
      className: 'clu-wrap',
      html: `<span class="clu" style="--e:${e.toFixed(1)}%;--m:${m.toFixed(1)}%" title="${n} trails — click to zoom in"><b>${n}</b><span class="sr-only"> trails</span></span>`,
      iconSize: [size, size],
      iconAnchor: [size / 2, size / 2],
    });
  }

  function clearLayers() {
    map.closePopup();
    cluster.clearLayers();
    Object.values(layers).forEach((L0) => {
      if (map.hasLayer(L0.marker)) map.removeLayer(L0.marker); // a dimmed dot
      map.removeLayer(L0.lines);
      if (L0.dots) map.removeLayer(L0.dots);
    });
    layers = {};
    selectedTrailId = null; // layers are gone (dataset rebuild) — drop selection
  }

  // komoot-style waypoint dots (route anchors: trailhead, huts, passes) are
  // decorative and only drawn from this zoom in — every trail's dots at the
  // overview zoom would be pure clutter
  const DOT_ZOOM = 12;
  function syncDots() {
    const on = map.getZoom() >= DOT_ZOOM;
    Object.values(layers).forEach((L0) => {
      if (!L0.dots) return;
      const want = on && L0.shown;
      if (want && !map.hasLayer(L0.dots)) L0.dots.addTo(map);
      if (!want && map.hasLayer(L0.dots)) map.removeLayer(L0.dots);
    });
  }
  map.on('zoomend', syncDots);

  // Design C map dot: difficulty fill, white rim, magenta ring for must-visits.
  // The 28px icon box is the tap target; the visible dot sits in its centre.
  // `dim` (filtered out) is part of the icon, not a toggled class: a marker
  // moving in or out of a cluster gets a fresh element built from the icon.
  const dotIcon = (t, dim = false) =>
    L.divIcon({
      className: dim ? 'dot-wrap is-dim' : 'dot-wrap',
      html: `<span class="dot dot--${t.difficulty}${t.mustVisit ? ' dot--must' : ''}"></span>`,
      iconSize: [28, 28],
      iconAnchor: [14, 14],
    });

  // one marker (+ route line when the trail has geometry) per trail
  function buildLayers() {
    clearLayers();
    trails.forEach((t) => {
      const col = COLORS[t.difficulty];
      const hasLine = Array.isArray(t.path) && t.path.length > 1;
      // dashed over a solid white casing — reads as "trail", komoot-style
      const casing = hasLine
        ? L.polyline(t.path, { color: '#ffffff', weight: 8, opacity: 0.7, lineCap: 'round', lineJoin: 'round' })
        : null;
      const line = hasLine
        ? L.polyline(t.path, { color: col, weight: 4, opacity: 0.9, lineCap: 'round', lineJoin: 'round', dashArray: '7 11' })
        : null;
      const marker = L.marker(t.peak, { icon: dotIcon(t), riseOnHover: true, alt: t.name, trailId: t.id });
      // hover card, built on open so the distance follows the current base
      marker.bindTooltip(() => tipHTML(t, { distKm: distFromBase(t), baseName: state.base.name }), {
        className: 'trail-tip',
        direction: 'top',
        offset: [0, -10],
        opacity: 1,
      });

      const lines = L.layerGroup(hasLine ? [casing, line] : []);
      lines.addTo(map);

      marker.on('mouseover', () => emphasize(t.id, true));
      marker.on('mouseout', () => emphasize(t.id, false));
      // leaving a cluster builds a fresh element — re-apply the selection
      marker.on('add', () => t.id === selectedTrailId && marker.getElement()?.classList.add('is-active'));
      // click = open the detail popup in place (no page scroll);
      // press-and-hold / long-press = jump straight down to the card
      // offsets compensate Leaflet's built-in 20px popup margin (tip hidden):
      // -2 → just above the dot; 10 → ~10px above the clicked line point
      marker.on('click', () => {
        if (consumeHold()) return;
        marker.closeTooltip();
        openTrailPopup(t, marker.getLatLng(), -2);
      });
      wireHold(marker, t);
      if (line) {
        line.on('mouseover', () => {
          emphasize(t.id, true);
          marker.openTooltip();
        });
        line.on('mouseout', () => {
          emphasize(t.id, false);
          marker.closeTooltip();
        });
        line.on('click', (e) => {
          if (consumeHold()) return;
          marker.closeTooltip();
          openTrailPopup(t, e.latlng, 10);
        });
        wireHold(line, t);
      }

      // numbered waypoint dots at the route anchors, in track order (1 = the
      // trailhead). Anchors sitting on the peak marker are skipped — the
      // marker is already there. waypoints come as [lat, lng, ele, kmFromStart].
      let dots = null;
      const wps = (t.waypoints || []).filter((p) => haversineKm([p[0], p[1]], t.peak) > 0.12);
      if (wps.length)
        dots = L.layerGroup(
          wps.map((p, i) => {
            const wp = L.marker([p[0], p[1]], {
              icon: L.divIcon({
                className: '',
                html: `<div class="wp-dot wp-dot--${t.difficulty}">${i + 1}</div>`,
                iconSize: [18, 18],
                iconAnchor: [9, 9],
              }),
              keyboard: false,
            });
            wp.bindTooltip(wpTipHTML(p, i, wps.length), {
              className: 'wp-tip',
              direction: 'top',
              offset: [0, -8],
              opacity: 1,
            });
            // tapping a dot behaves like tapping the line: open the trail popup
            wp.on('click', () => {
              wp.closeTooltip();
              openTrailPopup(t, wp.getLatLng(), -10);
            });
            return wp;
          })
        );

      layers[t.id] = { marker, line, casing, lines, dots, trail: t, shown: true };
    });
    // every dot starts in the cluster group (shown); render() moves the
    // filtered-out ones onto the map, dimmed
    cluster.addLayers(Object.values(layers).map((L0) => L0.marker));
    syncDots();
  }

  // hover card for a numbered waypoint dot — p = [lat, lng, ele, kmFromStart]
  function wpTipHTML(p, i, total) {
    const title = i === 0 ? 'Start · trailhead' : `Waypoint ${i + 1} of ${total}`;
    const facts = [
      p[3] != null ? `${p[3].toFixed(1)} km from start` : null,
      p[2] != null ? `${p[2].toLocaleString()} m` : null,
    ].filter(Boolean);
    return `<div class="wp-tip-in"><b>${title}</b>${facts.length ? `<span>${facts.join(' · ')}</span>` : ''}</div>`;
  }

  // filtered-out trails keep a dimmed dot on the map for context, outside the
  // clusters; their line and waypoint dots go. Cluster membership changes in
  // one batch each way, so the group re-clusters once rather than per marker.
  function syncShown(shown) {
    const join = [];
    const leave = [];
    Object.values(layers).forEach((L0) => {
      const on = shown.has(L0.trail.id);
      if (L0.shown === on) return;
      L0.shown = on;
      (on ? join : leave).push(L0);
      if (on) L0.lines.addTo(map);
      else map.removeLayer(L0.lines);
    });
    cluster.removeLayers(leave.map((L0) => L0.marker));
    join.forEach((L0) => {
      map.removeLayer(L0.marker);
      L0.marker.setIcon(dotIcon(L0.trail)).setZIndexOffset(0);
    });
    cluster.addLayers(join.map((L0) => L0.marker));
    leave.forEach((L0) => L0.marker.setIcon(dotIcon(L0.trail, true)).setZIndexOffset(-1000).addTo(map));
  }

  function emphasize(id, on) {
    const L0 = layers[id];
    if (!L0) return;
    // the selected trail stays highlighted even when the pointer leaves it
    // (and across popup close) — only selectTrail() can drop its highlight
    if (!on && id === selectedTrailId) return;
    if (L0.line) {
      L0.line.setStyle({ color: on ? SELECTED : COLORS[L0.trail.difficulty], weight: on ? 6 : 4, opacity: on ? 1 : 0.9 });
      L0.casing.setStyle({ weight: on ? 11 : 8, opacity: on ? 0.9 : 0.7 });
      if (on && L0.shown) L0.line.bringToFront();
    }
    L0.marker.getElement()?.classList.toggle('is-active', on);
    L0.marker.setZIndexOffset(on ? 1000 : L0.shown ? 0 : -1000);
    const card = document.querySelector(`.card[data-id="${CSS.escape(id)}"]`);
    if (card) card.classList.toggle('is-active', on);
  }

  // make a trail the persistent selection: it stays navy until another is
  // chosen. Reverts the previously selected one first.
  function selectTrail(id) {
    if (id === selectedTrailId) {
      emphasize(id, true);
      return;
    }
    const prev = selectedTrailId;
    selectedTrailId = id;
    if (prev) emphasize(prev, false);
    emphasize(id, true);
  }

  // map item hold / popup Details -> scroll down to the card and flash it in
  // waymark yellow (same palette as the trail-number tag) so the target is
  // unmistakable after the scroll settles. A card past the current page is
  // paged in first; a filtered-out one has no card to go to.
  let targetTimer;
  function scrollToCard(id) {
    const at = lastList.findIndex((t) => t.id === id);
    if (at < 0) return;
    if (at >= state.limit) {
      state.limit = Math.ceil((at + 1) / PAGE) * PAGE;
      render();
    }
    const card = document.querySelector(`.card[data-id="${CSS.escape(id)}"]`);
    if (!card) return;
    // land the card just below the sticky filter bar (1–3 rows tall by width)
    const y = card.getBoundingClientRect().top + window.pageYOffset - (fbar.offsetHeight + 24);
    window.scrollTo({ top: y, behavior: 'smooth' });
    document.querySelectorAll('.card.is-target').forEach((c) => c.classList.remove('is-active', 'is-target'));
    card.classList.add('is-active', 'is-target');
    clearTimeout(targetTimer);
    targetTimer = setTimeout(() => card.classList.remove('is-active', 'is-target'), 1500);
  }

  // card click -> fly the map to the trail. Deliberately NO page scroll — the
  // footer MAP button is the explicit "take me to the map" affordance.
  function flyToTrail(id) {
    const L0 = layers[id];
    if (!L0) return;
    if (L0.line) map.flyToBounds(L0.line.getBounds(), { padding: [80, 80], maxZoom: 14, duration: 0.7 });
    else map.flyTo(L0.trail.peak, Math.max(map.getZoom(), 12), { duration: 0.7 });
  }

  function scrollToMap() {
    document.querySelector('.mapwrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // frame the trails currently shown (all of them when nothing matches);
  // everything: true frames every trail — the default, whole-Alps page-load view
  function frameShown(animate = true, { everything = false } = {}) {
    const pts = [];
    Object.values(layers).forEach((L0) => {
      if (!L0.shown && !everything) return;
      pts.push(L0.trail.peak, L0.trail.start);
      if (L0.line) pts.push(...L0.trail.path);
    });
    if (!pts.length) Object.values(layers).forEach((L0) => pts.push(L0.trail.peak));
    if (!pts.length) return map.setView(state.base.coords, 11);
    const b = L.latLngBounds(pts).pad(0.12);
    if (animate) map.flyToBounds(b, { duration: 0.7, maxZoom: 13 });
    else map.fitBounds(b, { maxZoom: 13 });
  }

  // ==================== MAP POPUP / TRAIL SHEET + HOLD-TO-SCROLL ====================
  // Desktop: the shared Leaflet popup (design C card: photo, stats, access,
  // Details / GPX / OSM). Phones: the same card in the trail bottom sheet —
  // a popup that big would cover the whole map. Dismiss = ✕ or tap the map.
  let popupTrailId = null;
  const trailPopup = L.popup({
    className: 'trail-pop',
    closeButton: true,
    minWidth: 280,
    maxWidth: 280,
    autoPanPadding: [46, 46],
  });
  const trailSheet = sheet(document.getElementById('trail-sheet'));

  function openTrailPopup(t, latlng, offY) {
    // selectTrail handles dropping the previous selection's highlight — covers
    // switching straight between trails (the shared popup is just moved, so
    // 'popupclose' never fires for it)
    selectTrail(t.id);
    const html = popupHTML(t, {
      distKm: distFromBase(t),
      baseName: state.base.name,
      withGo: lastList.some((x) => x.id === t.id),
      saved: saved.has(t.id),
    });
    if (PHONE.matches) {
      trailSheet.body.innerHTML = html;
      trailSheet.open();
      return;
    }
    trailPopup.options.offset = [0, offY];
    popupTrailId = t.id;
    trailPopup.setLatLng(latlng).setContent(html).openOn(map);
  }
  // closing the popup keeps the trail selected (navy) so you can compare lines
  // without a popup open — the highlight only moves when another trail is clicked
  map.on('popupclose', () => (popupTrailId = null));
  // "Details" in either container: close it, then scroll to the card.
  // Share / Save act in place (the popup stays open).
  function onPopAction(e) {
    const act = e.target.closest('.pop-go, .share, .save');
    if (!act) return;
    if (act.classList.contains('share')) return shareTrail(act.dataset.id);
    if (act.classList.contains('save')) return toggleSaved(act.dataset.id);
    map.closePopup();
    trailSheet.close();
    scrollToCard(act.dataset.id);
  }
  map.getContainer().addEventListener('click', onPopAction);
  trailSheet.body.addEventListener('click', onPopAction);

  // press-and-hold (~0.5 s) on a marker/line scrolls straight to the card.
  // contextmenu doubles as native long-press on touch (Leaflet's tapHold
  // synthesizes it on iOS Safari). suppressClick swallows the click that the
  // browser fires on release after a hold, so the popup doesn't also open.
  let holdTimer;
  let suppressClick = false;
  let suppressReset;
  const cancelHold = () => clearTimeout(holdTimer);
  map.on('movestart zoomstart dragstart', cancelHold);
  function holdScroll(t) {
    suppressClick = true;
    clearTimeout(suppressReset);
    suppressReset = setTimeout(() => (suppressClick = false), 1200);
    map.closePopup();
    scrollToCard(t.id);
  }
  function consumeHold() {
    const held = suppressClick;
    suppressClick = false;
    return held;
  }
  function wireHold(layer, t) {
    layer.on('mousedown', () => {
      cancelHold();
      holdTimer = setTimeout(() => holdScroll(t), 500);
    });
    layer.on('mouseup mouseout', cancelHold);
    layer.on('contextmenu', (e) => {
      L.DomEvent.preventDefault(e.originalEvent || e);
      cancelHold();
      holdScroll(t);
    });
  }

  // ============================ STATE + RENDER ============================
  // The filters also live in the query string (readURL / writeURL below);
  // base, limit and open don't.
  const state = {
    region: 'all', // origin slug or 'all'
    q: '',
    diffs: new Set(),
    kind: 'all', // 'all' | 'day' | 'multi'
    must: false,
    season: false, // only trails in season this month
    saved: false, // only the visitor's saved trails
    base: { name: origins[0].name, coords: origins[0].coords },
    within: ANY, // index into WITHIN_KM; ANY = no distance limit
    sort: 'dist',
    limit: PAGE,
    open: new Set(), // cards with "More details" expanded — survives re-renders
  };
  let lastList = []; // the filtered + sorted list behind the grid

  // Saved (bookmarked) trail ids, kept in this browser only. Storage can be
  // missing or throw (private mode, blocked site data) — then saves last for
  // this page view and nothing breaks.
  const SAVED_KEY = 'hike-trip:saved';
  const saved = new Set(
    (() => {
      try {
        const ids = JSON.parse(localStorage.getItem(SAVED_KEY) ?? '[]');
        return Array.isArray(ids) ? ids.filter((x) => typeof x === 'string') : [];
      } catch {
        return [];
      }
    })()
  );
  function storeSaved() {
    try {
      localStorage.setItem(SAVED_KEY, JSON.stringify([...saved]));
    } catch {
      /* not persisted — still saved for this page view */
    }
  }

  const distFromBase = (t) => haversineKm(state.base.coords, t.start);

  // country flag (public/flags/<cc>.svg) for the base picker and the base pin
  const FLAGS = new Set(origins.map((o) => o.cc));
  const flagHTML = (cc) => `<img class="flag" src="/flags/${cc}.svg" alt="" width="18" height="14">`;
  const fromIcon = document.getElementById('from-icon');

  // every base change goes through here so the pin, the field's flag and the
  // subtitle track it. cc = ISO country code when known (no flag otherwise).
  function setBase(name, coords, cc) {
    state.base = { name, coords };
    const flag = FLAGS.has(cc) ? flagHTML(cc) : '';
    basePin.setLatLng(coords).setTooltipContent(`${flag ? flag + ' ' : ''}${esc(name)}`);
    fromIcon.innerHTML = flag || ICON.pin;
    document.getElementById('subtitle').textContent = `Hiking finder · base: ${name}`;
  }

  const SORTS = {
    dist: (a, b) => a.distKm - b.distKm,
    buzz: (a, b) =>
      (BUZZ_RANK[b.buzz] ?? 0) - (BUZZ_RANK[a.buzz] ?? 0) || b.mustVisit - a.mustVisit || a.distKm - b.distKm,
    diff: (a, b) => DIFF_RANK[a.difficulty] - DIFF_RANK[b.difficulty] || a.distKm - b.distKm,
    peak: (a, b) => (b.peakM ?? -1) - (a.peakM ?? -1),
    short: (a, b) => (a.lengthKm ?? Infinity) - (b.lengthKm ?? Infinity),
  };

  function visibleTrails() {
    const q = state.q.trim().toLowerCase();
    const list = trails
      .map((t) => ({ ...t, distKm: distFromBase(t) }))
      .filter((t) => {
        if (state.region !== 'all' && t.origin !== state.region) return false;
        if (state.diffs.size && !state.diffs.has(t.difficulty)) return false;
        if (state.kind === 'day' && t.type === 'Multi-day') return false;
        if (state.kind === 'multi' && t.type !== 'Multi-day') return false;
        if (state.must && !t.mustVisit) return false;
        if (state.season && !inSeason(t.season)) return false;
        if (state.saved && !saved.has(t.id)) return false;
        if (state.within < ANY && t.distKm > WITHIN_KM[state.within]) return false;
        if (q) {
          const hay = [t.name, t.area, t.massif, t.peakName, t.place, t.blurb].join(' ').toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
    return list.sort(SORTS[state.sort]);
  }

  const grid = document.getElementById('grid');
  const fbar = document.getElementById('fbar');
  const countEl = document.getElementById('count');
  const moreBtn = document.getElementById('more');
  const badge = document.getElementById('fb-badge');
  const savedN = document.getElementById('saved-n');

  function render() {
    const list = visibleTrails();
    lastList = list;
    const shown = new Set(list.map((t) => t.id));
    syncShown(shown);
    syncDots();
    if (popupTrailId && !shown.has(popupTrailId)) map.closePopup();
    // a filtered-out selection has no line or card any more — forget it so
    // its highlight doesn't silently linger on the dimmed dot
    if (selectedTrailId && !shown.has(selectedTrailId)) {
      const id = selectedTrailId;
      selectedTrailId = null;
      emphasize(id, false);
    }

    const page = list.slice(0, state.limit);
    grid.replaceChildren(...(page.length ? page.map(cardFor) : [emptyEl]));
    const rest = list.length - page.length;
    moreBtn.hidden = rest <= 0;
    moreBtn.textContent = `Show ${Math.min(PAGE, rest)} more`;

    countEl.innerHTML = `<b>${list.length}</b> of ${trails.length} trails · distances from <b>${esc(state.base.name)}</b> (straight-line to trailhead)`;
    document.getElementById('m-count').textContent = list.length;
    document.getElementById('m-region').textContent =
      state.region === 'all' ? 'All regions' : originBySlug[state.region].region;
    document.getElementById('fs-count').textContent = list.length;
    // the phone Filters badge counts what's set inside the filter sheet
    const active =
      state.diffs.size + (state.kind !== 'all') + state.must + state.season + state.saved + (state.within < ANY);
    badge.hidden = !active;
    badge.textContent = active;
    showSavedCount();
  }
  const showSavedCount = () => (savedN.textContent = trails.filter((t) => saved.has(t.id)).length);

  // Card elements are kept by id and reused: a filter or search change only
  // re-orders, attaches and detaches them (grid.replaceChildren), so photos
  // don't reload and the rise-in plays once per card. A card is rebuilt only
  // when its distance line changes (a new base); the saved and selected
  // states are painted onto the cached element each time it's shown.
  const cardCache = new Map(); // id -> { el, key }
  const emptyEl = Object.assign(document.createElement('div'), {
    className: 'empty',
    textContent: 'No trails match. Try clearing a filter.',
  });
  function cardFor(t, i) {
    const key = `${state.base.name}|${fmtDist(t.distKm)}`;
    let hit = cardCache.get(t.id);
    if (!hit || hit.key !== key) {
      const tpl = document.createElement('template');
      tpl.innerHTML = cardHTML(t, {
        distKm: t.distKm,
        baseName: state.base.name,
        index: i,
        open: state.open.has(t.id),
        saved: saved.has(t.id),
      }).trim();
      const el = tpl.content.firstElementChild;
      // re-attaching a node restarts CSS animations — let the rise-in play
      // once, then switch it off (a rebuilt card doesn't rise in again)
      if (hit) el.style.animation = 'none';
      // (only the card's own animation — a child's animationend bubbles up too)
      else {
        const done = (e) => {
          if (e.target !== el) return;
          el.style.animation = 'none';
          el.removeEventListener('animationend', done);
        };
        el.addEventListener('animationend', done);
      }
      wireCard(el);
      hit = { el, key };
      cardCache.set(t.id, hit);
    }
    const el = hit.el;
    paintSave(el.querySelector('.save'), saved.has(t.id));
    el.classList.toggle('is-active', t.id === selectedTrailId);
    el.classList.remove('is-target');
    return el;
  }

  // listeners go on once, when a card element is created (cardFor)
  function wireCard(card) {
    const id = card.dataset.id;
    // a clustered dot has no element or tooltip: light up its cluster instead
    const clusterOf = () => {
      const m = layers[id]?.marker;
      const vis = m && cluster.hasLayer(m) ? cluster.getVisibleParent(m) : null;
      return vis && vis !== m ? vis.getElement() : null;
    };
    card.addEventListener('mouseenter', () => {
      emphasize(id, true);
      layers[id]?.marker.openTooltip();
      clusterOf()?.classList.add('is-active');
    });
    card.addEventListener('mouseleave', () => {
      emphasize(id, false);
      layers[id]?.marker.closeTooltip();
      clusterOf()?.classList.remove('is-active');
    });
    card.addEventListener('click', () => flyToTrail(id));
    // the MAP button is the only thing that scrolls the page up
    card.querySelector('.seemap')?.addEventListener('click', (e) => {
      e.stopPropagation();
      flyToTrail(id);
      scrollToMap();
    });
    card.querySelector('.share')?.addEventListener('click', (e) => {
      e.stopPropagation();
      shareTrail(id);
    });
    card.querySelector('.save')?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSaved(id);
    });
    // downloads, the photo credit and the "More details" panel are their own
    // thing — don't also fly the map
    card
      .querySelectorAll('.gpxdl, .credit, .more')
      .forEach((el) => el.addEventListener('click', (e) => e.stopPropagation()));
    const more = card.querySelector('.more');
    more?.addEventListener('toggle', () => (more.open ? state.open.add(id) : state.open.delete(id)));
  }

  moreBtn.addEventListener('click', () => {
    state.limit += PAGE;
    render();
  });

  // ============================ SHARE + SAVE ============================
  // Share hands the absolute /?trail=<id> deep link (it opens that trail's
  // popup) to the OS share sheet where there is one, else copies it.
  async function shareTrail(id) {
    const t = trails.find((x) => x.id === id);
    if (!t) return;
    const url = new URL(`/?trail=${encodeURIComponent(id)}`, location.origin).href;
    if (navigator.share) {
      try {
        await navigator.share({ title: t.name, text: `${t.name} · ${t.place}`, url });
        return;
      } catch (err) {
        if (err?.name === 'AbortError') return; // the visitor closed the sheet
      }
    }
    toast((await copyText(url)) ? 'Link copied' : 'Couldn’t copy the link');
  }

  async function copyText(text) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // no async clipboard (insecure context, permission denied): legacy copy
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:0;opacity:0';
      document.body.append(ta);
      ta.select();
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        /* nothing left to try */
      }
      ta.remove();
      return ok;
    }
  }

  const toastEl = document.getElementById('toast');
  let toastTimer;
  function toast(msg) {
    toastEl.textContent = msg;
    toastEl.classList.add('is-on');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toastEl.classList.remove('is-on'), 2200);
  }

  function paintSave(btn, on) {
    if (!btn) return;
    btn.classList.toggle('is-saved', on);
    btn.setAttribute('aria-pressed', String(on));
    btn.title = saveTitle(on);
  }

  // Save updates every copy of the button (card, popup, trail sheet) in place;
  // with the Saved filter on, the list re-renders so it stays true.
  function toggleSaved(id) {
    const on = !saved.has(id);
    if (on) saved.add(id);
    else saved.delete(id);
    storeSaved();
    // cached cards that aren't in the grid right now are repainted by cardFor
    document.querySelectorAll(`.save[data-id="${CSS.escape(id)}"]`).forEach((b) => paintSave(b, on));
    if (state.saved) render();
    else showSavedCount();
  }

  // ============================ CONTROLS ============================
  const press = (btn, on) => {
    btn.classList.toggle('on', on);
    btn.setAttribute('aria-pressed', String(on));
  };

  // region chips — filter to one origin, measure from its home town and fly
  // the map there; "All" keeps the current base and flies back out to the
  // default whole-Alps view (even after zooming in on one trail)
  const regionBtns = [...document.querySelectorAll('.fb-regions .seg')];
  function setRegion(slug, { fly = true } = {}) {
    state.region = slug;
    state.limit = PAGE;
    regionBtns.forEach((b) => press(b, b.dataset.region === slug));
    if (slug !== 'all') {
      const o = originBySlug[slug];
      setBase(o.name, o.coords, o.cc);
      fromInput.value = o.name;
    }
    fillBases();
    render();
    if (fly) frameShown(true, { everything: slug === 'all' });
  }
  regionBtns.forEach((b) =>
    b.addEventListener('click', () => {
      setRegion(b.dataset.region);
      writeURL(true);
    })
  );

  // difficulty — three toggles; none active == show all
  const diffBtns = [...document.querySelectorAll('#fb-diff .seg')];
  diffBtns.forEach((b) =>
    b.addEventListener('click', () => {
      const d = b.dataset.d;
      const on = !state.diffs.has(d);
      if (on) state.diffs.add(d);
      else state.diffs.delete(d);
      press(b, on);
      state.limit = PAGE;
      render();
      writeURL(true);
    })
  );

  // trip length — reframes the map on what's left (multi-day routes spread
  // across the Alps; "All" zooms back out after drilling in)
  const kindBtns = [...document.querySelectorAll('.fb-kind .seg')];
  kindBtns.forEach((b) =>
    b.addEventListener('click', () => {
      state.kind = b.dataset.kind;
      kindBtns.forEach((x) => press(x, x === b));
      state.limit = PAGE;
      render();
      frameShown();
      writeURL(true);
    })
  );

  // the "show only" toggles: must visit · in season now · saved
  const mustBtn = document.getElementById('must');
  const seasonBtn = document.getElementById('in-season');
  const savedBtn = document.getElementById('saved-only');
  [
    [mustBtn, 'must'],
    [seasonBtn, 'season'],
    [savedBtn, 'saved'],
  ].forEach(([btn, key]) =>
    btn.addEventListener('click', () => {
      state[key] = !state[key];
      press(btn, state[key]);
      state.limit = PAGE;
      render();
      writeURL(true);
    })
  );

  const qInput = document.getElementById('q');
  qInput.addEventListener('input', () => {
    state.q = qInput.value;
    state.limit = PAGE;
    render();
    writeURL(false);
  });
  const sortSel = document.getElementById('sort');
  sortSel.addEventListener('change', () => {
    state.sort = sortSel.value;
    render();
    writeURL(true);
  });
  const distRange = document.getElementById('dist');
  const distVal = document.getElementById('distVal');
  function showDist() {
    const label = state.within >= ANY ? 'Any' : `${WITHIN_KM[state.within]} km`;
    distVal.textContent = label;
    distRange.setAttribute('aria-valuetext', state.within >= ANY ? 'Any distance' : `Within ${label}`);
  }
  distRange.addEventListener('input', () => {
    state.within = +distRange.value;
    showDist();
    state.limit = PAGE;
    render();
    writeURL(false);
  });

  // ---- base picker ("From"): a combobox of the known base towns, each with
  // its country's flag (a native <datalist> can't show images). Free text
  // still works — anything not in the list goes to Nominatim on Enter / blur.
  const BASES = origins.flatMap((o) =>
    Object.entries(o.bases).map(([name, coords]) => ({ name, coords, origin: o.slug, cc: o.cc, country: o.country }))
  );
  const fold = (s) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase(); // "Rateče" ~ "ratece"
  const fromInput = document.getElementById('from');
  const baseList = document.getElementById('bases-list');
  let baseOpts = [];
  let activeOpt = -1;

  // the selected region's towns first; what's typed filters by town or country
  // (just focusing the field on the current base lists them all)
  function fillBases() {
    const q = fold(fromInput.value.trim());
    const all = !q || q === fold(state.base.name);
    const mine = (b) => (state.region !== 'all' && b.origin === state.region ? 0 : 1);
    baseOpts = BASES.filter((b) => all || fold(b.name).includes(q) || fold(b.country).includes(q)).sort(
      (a, b) => mine(a) - mine(b)
    );
    activeOpt = -1;
    fromInput.removeAttribute('aria-activedescendant');
    baseList.innerHTML = baseOpts
      .map(
        (b, i) =>
          `<li role="option" id="base-opt-${i}" data-i="${i}" aria-selected="false">${flagHTML(b.cc)}` +
          `<span class="b-name">${esc(b.name)}</span><span class="b-country">${esc(b.country)}</span></li>`
      )
      .join('');
  }
  function openBases() {
    fillBases();
    baseList.hidden = !baseOpts.length;
    fromInput.setAttribute('aria-expanded', String(!baseList.hidden));
  }
  function closeBases() {
    baseList.hidden = true;
    activeOpt = -1;
    fromInput.setAttribute('aria-expanded', 'false');
    fromInput.removeAttribute('aria-activedescendant');
  }
  function moveActive(step) {
    if (baseList.hidden) openBases();
    if (!baseOpts.length) return;
    activeOpt = (activeOpt + step + baseOpts.length) % baseOpts.length;
    baseList.querySelectorAll('[role="option"]').forEach((li, i) => li.setAttribute('aria-selected', String(i === activeOpt)));
    const li = document.getElementById(`base-opt-${activeOpt}`);
    fromInput.setAttribute('aria-activedescendant', li.id);
    li.scrollIntoView({ block: 'nearest' });
  }
  function pickBase(i) {
    const b = baseOpts[i];
    if (!b) return;
    fromInput.value = b.name;
    closeBases();
    resolveBase();
  }
  fromInput.addEventListener('focus', openBases);
  fromInput.addEventListener('input', openBases);
  // let a tap on an option land before the list goes away
  fromInput.addEventListener('blur', () => setTimeout(closeBases, 150));
  baseList.addEventListener('pointerdown', (e) => e.preventDefault()); // keep focus in the field
  baseList.addEventListener('click', (e) => {
    const li = e.target.closest('[role="option"]');
    if (li) pickBase(+li.dataset.i);
  });

  async function resolveBase() {
    const name = fromInput.value.trim();
    if (!name) return;
    // an origin's home town switches to its region (same as its chip)
    // matched like the list filters (accents folded): "ratece" picks Rateče
    const o = origins.find((x) => fold(x.name) === fold(name));
    if (o) {
      if (o.slug !== state.region) {
        setRegion(o.slug);
        writeURL(true);
      } else {
        setBase(o.name, o.coords, o.cc);
        render();
      }
      return;
    }
    const known = BASES.find((b) => fold(b.name) === fold(name));
    if (known) {
      setBase(known.name, known.coords, known.cc);
      fromInput.value = known.name;
      render();
      return;
    }
    // try Nominatim (OpenStreetMap) for anything else; biased to the region.
    // addressdetails gives the country, so a town in a country we have a flag
    // for gets it too.
    try {
      fromInput.style.opacity = 0.6;
      const bias = state.region === 'all' ? '' : ', ' + originBySlug[state.region].searchBias;
      const url =
        'https://nominatim.openstreetmap.org/search?format=json&limit=1&addressdetails=1&q=' +
        encodeURIComponent(name + bias);
      const r = await fetch(url, { headers: { Accept: 'application/json' } });
      const j = await r.json();
      if (j && j[0]) {
        setBase(name, [parseFloat(j[0].lat), parseFloat(j[0].lon)], j[0].address?.country_code);
        render();
      }
    } catch (err) {
      /* offline / rate-limited: keep previous base */
    } finally {
      fromInput.style.opacity = 1;
    }
  }
  fromInput.addEventListener('change', resolveBase);
  fromInput.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      moveActive(e.key === 'ArrowDown' ? 1 : -1);
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (!baseList.hidden && activeOpt >= 0) pickBase(activeOpt);
      else {
        closeBases();
        resolveBase();
      }
    } else if (e.key === 'Escape' && !baseList.hidden) {
      e.stopPropagation(); // the phone filter sheet stays open
      closeBases();
    }
  });

  // basemap toggle
  const bLight = document.getElementById('lyr-light');
  const bTerrain = document.getElementById('lyr-terrain');
  bLight.addEventListener('click', () => {
    if (map.hasLayer(terrain)) map.removeLayer(terrain);
    light.addTo(map);
    bLight.classList.add('on');
    bTerrain.classList.remove('on');
  });
  bTerrain.addEventListener('click', () => {
    if (map.hasLayer(light)) map.removeLayer(light);
    terrain.addTo(map);
    bTerrain.classList.add('on');
    bLight.classList.remove('on');
  });

  document.getElementById('recenter').addEventListener('click', () => frameShown());

  // ============================ PHONE LAYOUT ============================
  // Difficulty + the whole second row live in the filter sheet below 640px.
  const filterSheet = sheet(document.getElementById('filter-sheet'));
  const fsSlot = document.getElementById('fs-slot');
  relocate(document.getElementById('fb-diff'), fsSlot);
  relocate(document.getElementById('fb-row2'), fsSlot);
  document.getElementById('fb-more-btn').addEventListener('click', filterSheet.open);
  // Reset clears everything the sheet holds (region and search stay)
  document.getElementById('fs-reset').addEventListener('click', () => {
    Object.assign(state, {
      diffs: new Set(),
      kind: 'all',
      must: false,
      season: false,
      saved: false,
      within: ANY,
      sort: 'dist',
      limit: PAGE,
    });
    syncControls();
    render();
    frameShown();
    writeURL(true);
  });

  // ============================ URL STATE ============================
  // The filters round-trip through the query string, so a filtered view can be
  // reloaded, bookmarked and shared, and Back undoes a chip click. Defaults are
  // left out (a clean page = a clean URL). Chips, toggles and sort push a
  // history entry; search typing and slider dragging replace the current one.
  //   region=<slug> diff=easy,hard trip=day|multi within=<km> must=1 season=1
  //   saved=1 q=<text> sort=<key>   — plus the one-shot ?trail=<id> deep link,
  //   which the first filter change drops
  const DIFFS = Object.keys(DIFF_RANK);
  const own = (o, k) => k != null && Object.hasOwn(o, k);
  function readURL() {
    const p = new URLSearchParams(location.search);
    const within = WITHIN_KM.indexOf(Number(p.get('within')));
    return {
      region: own(originBySlug, p.get('region')) ? p.get('region') : 'all',
      diffs: new Set((p.get('diff') ?? '').split(',').filter((d) => DIFFS.includes(d))),
      kind: ['day', 'multi'].includes(p.get('trip')) ? p.get('trip') : 'all',
      within: within < 0 ? ANY : within,
      must: p.get('must') === '1',
      season: p.get('season') === '1',
      saved: p.get('saved') === '1',
      q: p.get('q') ?? '',
      sort: own(SORTS, p.get('sort')) ? p.get('sort') : 'dist',
    };
  }

  function writeURL(push) {
    const p = new URLSearchParams();
    if (state.region !== 'all') p.set('region', state.region);
    if (state.diffs.size) p.set('diff', DIFFS.filter((d) => state.diffs.has(d)).join(','));
    if (state.kind !== 'all') p.set('trip', state.kind);
    if (state.within < ANY) p.set('within', WITHIN_KM[state.within]);
    if (state.must) p.set('must', '1');
    if (state.season) p.set('season', '1');
    if (state.saved) p.set('saved', '1');
    if (state.q.trim()) p.set('q', state.q.trim());
    if (state.sort !== 'dist') p.set('sort', state.sort);
    const qs = p.toString().replace(/%2C/g, ','); // keep diff=easy,hard readable
    const url = location.pathname + (qs ? `?${qs}` : '') + location.hash;
    if (url === location.pathname + location.search + location.hash) return;
    history[push ? 'pushState' : 'replaceState'](null, '', url);
  }

  // every control mirrors `state` (after the URL or the sheet's Reset set it)
  function syncControls() {
    regionBtns.forEach((b) => press(b, b.dataset.region === state.region));
    diffBtns.forEach((b) => press(b, state.diffs.has(b.dataset.d)));
    kindBtns.forEach((b) => press(b, b.dataset.kind === state.kind));
    press(mustBtn, state.must);
    press(seasonBtn, state.season);
    press(savedBtn, state.saved);
    qInput.value = state.q;
    sortSel.value = state.sort;
    distRange.value = state.within;
    showDist();
  }

  // query string -> state, controls and grid: on load (no fly — loadData
  // frames the map) and on Back / Forward (flies like the chip it undoes)
  function applyURL({ fly }) {
    const f = readURL();
    const kindChanged = f.kind !== state.kind;
    Object.assign(state, { ...f, region: state.region, limit: PAGE });
    syncControls();
    if (f.region !== state.region) setRegion(f.region, { fly });
    else {
      render();
      if (fly && kindChanged) frameShown();
    }
  }
  addEventListener('popstate', () => applyURL({ fly: true }));

  // ============================ DATA ============================
  // Bundled data first (instant, offline-safe), then every region from D1 via
  // the Worker. A popup / selection open across the swap is restored.
  async function loadData() {
    trails = staticTrails;
    buildLayers();
    applyURL({ fly: false });
    frameShown(false);
    openDeepLink();

    try {
      const r = await fetch('/api/trails?origin=all');
      if (!r.ok) return;
      const j = await r.json();
      if (!Array.isArray(j.trails) || !j.trails.length) return;
      const keepPopup = popupTrailId;
      const keepSel = selectedTrailId;
      trails = j.trails.map(decorate);
      cardCache.clear(); // D1 rows can differ from the bundle — build fresh cards
      buildLayers();
      render();
      if (keepSel && layers[keepSel]) selectTrail(keepSel);
      if (keepPopup && layers[keepPopup]) openTrailPopup(layers[keepPopup].trail, layers[keepPopup].trail.peak, -2);
      else if (deepLinkPending) openDeepLink();
    } catch {
      /* offline or no API — keep the build-time snapshot */
    }
  }

  // /?trail=<id> (the Explore page's "Show on map", a shared link) fits that
  // trail and opens its card on the map. The popup belongs on the dot, so a
  // dot still inside a cluster at that zoom is zoomed out of it first.
  // A zoom out of a cluster is async: if the D1 swap rebuilds the layers
  // before it lands, the cluster never calls back — loadData re-runs it.
  let deepLinkPending = false;
  function openDeepLink() {
    const id = new URLSearchParams(location.search).get('trail');
    if (!own(layers, id)) return;
    const L0 = layers[id];
    const t = L0.trail;
    if (L0.line) map.fitBounds(L0.line.getBounds(), { padding: [60, 60], maxZoom: 14, animate: false });
    else map.setView(t.peak, 13, { animate: false });
    deepLinkPending = true;
    const open = () => {
      if (!deepLinkPending || !own(layers, id)) return;
      deepLinkPending = false;
      const cur = layers[id].trail; // the current dataset's row, not a stale one
      openTrailPopup(cur, cur.peak, -2);
    };
    if (L0.shown && map.getZoom() < CLUSTER_OFF_ZOOM) cluster.zoomToShowLayer(L0.marker, open);
    else open();
  }

  fillBases();
  loadData();
</script>
