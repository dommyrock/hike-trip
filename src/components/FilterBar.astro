---
// Trail-finder filter bar (design B pill bar, two rows).
//   row 1  region chips · difficulty · search      (+ the phone-only Filters button)
//   row 2  From base · Within slider · trip length · must visit · in season · saved · sort
// On phones the difficulty group and row 2 move into the filter bottom sheet
// (src/lib/mobile.js relocate) — same elements, so the wiring in index.astro
// doesn't care which layout is active.
interface Props {
  origins: { slug: string; label: string; name: string }[];
  counts: Record<string, number>;
  total: number;
  home: { name: string; cc: string };
}

import { DIFF_LABEL } from '../lib/geo.js';
import { ICON } from '../lib/icons.js';

const { origins, counts, total, home } = Astro.props;
const DIFFS = Object.entries(DIFF_LABEL);
const KINDS = [
  ['all', 'All'],
  ['day', 'Day hikes'],
  ['multi', 'Multi-day'],
];
// Within slider stops (km). The range input is an index into these plus one
// last stop, "Any" (no limit); index.astro reads them from data-stops.
const WITHIN_KM = [5, 10, 25, 50, 100, 250];
---

<div class="fbar" id="fbar">
  <div class="fb-row">
    <div class="fb-regions" role="group" aria-label="Region">
      <button type="button" class="seg on" data-region="all" aria-pressed="true">All <small>{total}</small></button>
      {
        origins.map((o) => (
          <button type="button" class="seg" data-region={o.slug} aria-pressed="false">
            {o.label} <small>{counts[o.slug]}</small>
          </button>
        ))
      }
    </div>
    <div class="fb-diff" id="fb-diff" role="group" aria-label="Difficulty">
      {
        DIFFS.map(([d, label]) => (
          <button type="button" class="seg" data-d={d} aria-pressed="false">
            <i class={`dot dot--${d}`} />
            {label}
          </button>
        ))
      }
    </div>
    <div class="fb-search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.2-3.2"></path></svg>
      <input id="q" type="search" placeholder="Search trails, peaks, areas…" autocomplete="off" aria-label="Search trails, peaks, areas" />
    </div>
    <button type="button" class="fb-more-btn" id="fb-more-btn" aria-haspopup="dialog" aria-controls="filter-sheet">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"></path><circle cx="16" cy="6" r="2"></circle><circle cx="10" cy="12" r="2"></circle><circle cx="18" cy="18" r="2"></circle></svg>
      Filters <b class="fb-badge" id="fb-badge" hidden>0</b>
    </button>
  </div>

  <div class="fb-row fb-row2" id="fb-row2">
    <!-- base picker: a combobox (index.astro) — a native datalist can't show
         the country flags; free text still goes to Nominatim -->
    <div class="fb-from" title="Distances are measured from here">
      <span class="fb-from-icon" id="from-icon" aria-hidden="true"
        ><img class="flag" src={`/flags/${home.cc}.svg`} alt="" width="18" height="14" /></span
      >
      <input
        id="from"
        type="text"
        value={home.name}
        autocomplete="off"
        role="combobox"
        aria-label="Distances from"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="bases-list"
      />
      <ul class="bases-list" id="bases-list" role="listbox" aria-label="Base towns" hidden></ul>
    </div>
    <div class="fb-within">
      <label class="lbl" for="dist">Within</label>
      <input
        id="dist"
        type="range"
        min="0"
        max={WITHIN_KM.length}
        step="1"
        value={WITHIN_KM.length}
        data-stops={WITHIN_KM.join(',')}
        aria-valuetext="Any distance"
        title="Max distance from base"
      />
      <span class="val" id="distVal">Any</span>
    </div>
    <div class="fb-kind" role="group" aria-label="Trip length">
      {
        KINDS.map(([k, label], i) => (
          <button type="button" class:list={['seg', { on: i === 0 }]} data-kind={k} aria-pressed={i === 0 ? 'true' : 'false'}>
            {label}
          </button>
        ))
      }
    </div>
    <div class="fb-toggles" role="group" aria-label="Show only">
      <button type="button" class="seg seg--must" id="must" aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"></path></svg>
        Must visit
      </button>
      <button
        type="button"
        class="seg seg--season"
        id="in-season"
        aria-pressed="false"
        aria-label="In season now"
        title="Only trails whose season includes this month"
      >
        <Fragment set:html={ICON.season} />
        In season
      </button>
      <button type="button" class="seg seg--saved" id="saved-only" aria-pressed="false" title="Only the trails you saved">
        <Fragment set:html={ICON.bookmark} />
        Saved <small id="saved-n">0</small>
      </button>
    </div>
    <label class="fb-sort">
      <span>Sort</span>
      <select id="sort">
        <option value="dist">Nearest</option>
        <option value="buzz">Trending</option>
        <option value="diff">Easiest first</option>
        <option value="peak">Highest point</option>
        <option value="short">Shortest</option>
      </select>
    </label>
  </div>
</div>
