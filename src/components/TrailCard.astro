---
import { cardHTML } from '../lib/card.js';

interface Props {
  trail: any;
  distKm: number;
  baseName?: string;
  index?: number;
}

const { trail: t, distKm, baseName = 'Ortisei', index = 0 } = Astro.props;

// Same markup the client re-render uses (src/lib/card.js) — one source of truth.
const html = cardHTML(t, { distKm, baseName, index });
---

<Fragment set:html={html} />
